  {
   "id": "admit-0",
   "shot": "admit",
   "speaker": "N",
   "text": "That question invites an admission.",
   "file": "vo/admit-0.wav",
   "start": 63.978,
   "dur": 1.947
  },
  {
   "id": "admit-1",
   "shot": "admit",
   "speaker": "N",
   "text": "If you honestly don't know, say, no officer, could you tell me?",
   "file": "vo/admit-1.wav",
   "start": 66.205,
   "dur": 3.295
  },
  {
   "id": "admit-2",
   "shot": "admit",
   "speaker": "N",
   "text": "If you do know, don't lie. Keep it short and honest.",
   "file": "vo/admit-2.wav",
   "start": 69.779,
   "dur": 2.85
  },
